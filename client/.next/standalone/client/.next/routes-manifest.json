{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/planes",
      "regex": "^/admin/planes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/planes(?:/)?$"
    },
    {
      "page": "/auth/error",
      "regex": "^/auth/error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/error(?:/)?$"
    },
    {
      "page": "/auth/signin",
      "regex": "^/auth/signin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/signin(?:/)?$"
    },
    {
      "page": "/como-funciona",
      "regex": "^/como\\-funciona(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/como\\-funciona(?:/)?$"
    },
    {
      "page": "/contacto",
      "regex": "^/contacto(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contacto(?:/)?$"
    },
    {
      "page": "/planes",
      "regex": "^/planes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/planes(?:/)?$"
    },
    {
      "page": "/servicios",
      "regex": "^/servicios(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/servicios(?:/)?$"
    },
    {
      "page": "/suscripciones",
      "regex": "^/suscripciones(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/suscripciones(?:/)?$"
    },
    {
      "page": "/testimonios",
      "regex": "^/testimonios(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/testimonios(?:/)?$"
    },
    {
      "page": "/usuarios",
      "regex": "^/usuarios(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios(?:/)?$"
    },
    {
      "page": "/usuarios/admin/planes",
      "regex": "^/usuarios/admin/planes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/admin/planes(?:/)?$"
    },
    {
      "page": "/usuarios/asistente-legal",
      "regex": "^/usuarios/asistente\\-legal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/asistente\\-legal(?:/)?$"
    },
    {
      "page": "/usuarios/generacion-contenidos",
      "regex": "^/usuarios/generacion\\-contenidos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/generacion\\-contenidos(?:/)?$"
    },
    {
      "page": "/usuarios/gestion",
      "regex": "^/usuarios/gestion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/gestion(?:/)?$"
    },
    {
      "page": "/usuarios/mensajes",
      "regex": "^/usuarios/mensajes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/mensajes(?:/)?$"
    },
    {
      "page": "/usuarios/wordpress-integration",
      "regex": "^/usuarios/wordpress\\-integration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/usuarios/wordpress\\-integration(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}